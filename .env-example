QDRANT_HOST=qdrant.example.com
QDRANT_PORT=6333

OLLAMA_HOST=ollama.example.com
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_NLU_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Answer generation provider: "ollama" (local) or "groq" (API)
GENERATE_PROVIDER=ollama
GROQ_API_KEY=REPLACE_WITH_YOUR_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Cross-encoder reranker (sentence-transformers model from HuggingFace)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Candidates retrieved per collection before reranking
RETRIEVAL_TOP_K=30
# Final chunks passed to the LLM after reranking
RERANKER_TOP_K=30

POSTGRES_HOST=db.example.com
POSTGRES_PORT=5432
POSTGRES_USER=repair_buddy
POSTGRES_PASSWORD=change_me
POSTGRES_DB=repair_buddy


# LangSmith tracing (optional - enables LLM call observability at smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_REPLACE_WITH_YOUR_KEY
LANGSMITH_PROJECT=repair-buddy
# US region: https://api.smith.langchain.com
# EU region: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

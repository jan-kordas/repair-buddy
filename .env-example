QDRANT_HOST=qdrant.example.com
QDRANT_PORT=6333

OLLAMA_HOST=ollama.example.com
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_NLU_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Answer generation provider: "ollama" (local), "groq" or "openai"
GENERATE_PROVIDER=ollama
GROQ_API_KEY=REPLACE_WITH_YOUR_KEY
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
OPENAI_MODEL=gpt-4o-mini

# Reranker backend: "local" (CrossEncoder in the container, CPU, slow)
#                 | "llamacpp" (native llama-server --rerank on the host, fast)
#                 | "off" (no reranking, Qdrant vector order)
# See README "Reranker modes" for llama-server setup.
RERANKER_MODE=llamacpp
# Host/port of the native llama-server (used in "llamacpp" mode).
# Inside docker compose the host is overridden to host.docker.internal.
LLAMACPP_HOST=localhost
LLAMACPP_PORT=8081
# Cross-encoder model for "local" mode (sentence-transformers, HuggingFace).
# Lighter alternative (weaker on Polish, emits logits — set RELEVANCE_THRESHOLD=0.5):
# cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Candidates retrieved per collection before reranking. Sets rerank latency:
# "llamacpp" on Apple Silicon ~42 ms/candidate, "local" on CPU ~1 s/candidate.
RETRIEVAL_TOP_K=48
# Final chunks passed to the LLM after reranking
RERANKER_TOP_K=10
# Relevance threshold on the [0,1] sigmoid scale: chunks below this score are
# dropped before LLM generation. BGE-reranker-v2-m3: relevant pairs typically
# score 0.005-0.5, irrelevant ones <1e-3. Not applied when RERANKER_MODE=off.
RELEVANCE_THRESHOLD=0.001

POSTGRES_HOST=db.example.com
POSTGRES_PORT=5432
POSTGRES_USER=repair_buddy
POSTGRES_PASSWORD=change_me
POSTGRES_DB=repair_buddy


# LangSmith tracing (optional - enables LLM call observability at smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_REPLACE_WITH_YOUR_KEY
LANGSMITH_PROJECT=repair-buddy
# US region: https://api.smith.langchain.com
# EU region: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
